# .env.example
# Example environment variables for EIS Analysis Demo

# --- Google Cloud Project settings ---
# Replace with your actual Google Cloud project ID
PROJECT_ID=your-gcp-project-id
# Replace with the region you are using for Cloud Run, Storage, etc.
REGION=us-central1

# --- Storage settings ---
# Replace with the names of your GCS buckets
# Convention: project-id-input / project-id-output
INPUT_BUCKET=your-gcp-project-id-input
OUTPUT_BUCKET=your-gcp-project-id-output

# --- Document AI settings ---
# Optional: To use Document AI processing:
# 1. Enable Document AI API in your Google Cloud project
# 2. Create a processor (e.g., Form Parser type)
# 3. Paste the Processor ID below (the string after the last '/')
# 4. Ensure your application has credentials (e.g., via Application Default Credentials)
DOCUMENT_PROCESSOR_ID= # Example: d2a89e31c0d743af
# Location of your Document AI processor (e.g., us, eu)
DOCUMENT_PROCESSOR_LOCATION=us

# --- API settings ---
# Host and Port for the local development server
API_HOST=0.0.0.0
API_PORT=8000

# --- Application settings ---
# Set to True to enable debug mode (e.g., auto-reload)
DEBUG=True

# --- Add other settings as needed ---
# Example: Vertex AI settings (for later milestones)
# VERTEX_LLM_MODEL=text-bison@002

